# Copy to .env. Everything is optional: with no keys the built-in mock provider is used.
GROQ_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
ENABLE_OLLAMA=false
OLLAMA_BASE_URL=http://localhost:11434/v1

SWITCHBOARD_DB=switchboard.db
REDIS_URL=                 # e.g. redis://localhost:6379/0 -> Redis/Lua limiter (otherwise in-memory)
REQUIRE_AUTH=false
ADMIN_KEY=                 # set this in any shared deployment
ENABLE_MOCK=               # unset = auto (mock only when no real provider key is present)

CACHE_ENABLED=true
CACHE_TEMP_THRESHOLD=0.3
CACHE_SIM_THRESHOLD=0.92
CACHE_TTL_S=3600
CACHE_SEMANTIC=auto       # auto = semantic layer only with a real embedding model | on | off
CACHE_GUARD=true
EMBEDDER=auto              # auto | hashing | sentence-transformers
EMBEDDER_MODEL=BAAI/bge-small-en-v1.5
ROUTER_MODE=heuristic      # heuristic | learned
ONLINE_MAX_WAIT_S=2
BATCH_MAX_WAIT_S=30
LOG_LEVEL=INFO
LOG_PROMPTS=false
